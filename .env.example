# Copy to .env and fill in. Never commit .env.
QA_UI_BASE_URL=https://sierraleone-hcm.digit.org/workbench-ui/employee

# Optional: only if the site needs a login
# QA_LOGIN_URL is required if the site has a login (the login page URL)
# QA_LOGIN_URL=
# QA_USERNAME=
# QA_PASSWORD=
# QA_TEST_MOBILE=
# QA_TEST_OTP=

# Complaints (CMP-08): an 11-digit mobile number the team owns, used as the complainant number when tests create real complaints
QA_COMPLAINANT_MOBILE=

# User management: test users get a synthetic mobile number generated at run time (decided 2026-11-18), so nothing is needed here.
# Optional: re-run the later lifecycle steps (USR-11-H1, USR-13-H3/H5/H4) against an earlier test user (qatest<digits> only)
# QA_LIFECYCLE_USERNAME=

# Runs (global-setup-session.ts): each run empties allure-results and logs in again by itself when the saved session
# has expired. Optional overrides:
# QA_REFRESH_AUTH=1          always log in again at the start of the run
# QA_KEEP_ALLURE_RESULTS=1   keep earlier results (to combine several runs in one report)
